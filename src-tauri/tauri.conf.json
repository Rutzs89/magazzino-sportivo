{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magazzino Sportivo",
  "version": "0.3.13",
  "identifier": "it.magazzinosportivo.app",
  "build": {
    "beforeDevCommand": "npm run build:app",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Magazzino Sportivo",
        "width": 1200,
        "height": 860,
        "minWidth": 720,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Magazzino divise e materiale per societa sportive",
    "longDescription": "Gestione del magazzino divise e materiale di una societa sportiva. Tutti i dati restano sul computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "languages": [
          "Italian"
        ],
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://magazzino-sportivo.vercel.app/ultima-versione.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFMjdGQzg4NTdBMTIwNUMKUldSY0lLRlhpUHdubmg0cU8xb20rNE9OVUtWdmVyejJQUkxPcWFac25hSGU5QW1vT2NqU05QTmkK"
    }
  }
}
